# 서버 포트 (로컬 전용, Vercel에서는 자동으로 처리됨)
PORT=4000

# 총관리자 비밀번호 - 매장 생성/삭제, 태그목록 수정, 백업/복원, 복구 스냅샷 등 전체 관리
ADMIN_PASSWORD=바꾸세요_총관리자비번

# 매장관리자 비밀번호 - 설정/직원목록/근무형태템플릿/공휴일·이슈일/스케줄 등 수정 가능
# (단, 태그목록은 수정 불가 - 필요하면 총관리자에게 요청)
MANAGER_PASSWORD=바꾸세요_매장관리자비번

# 사용자 비밀번호 - 조회 전용 + 개인 지정 태그(요청휴무 등록)만 추가/삭제 가능
STAFF_PASSWORD=바꾸세요_사용자비번

# Supabase 프로젝트 정보 (Supabase 대시보드 > Project Settings > API 에서 확인)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role 키 - 서버 전용 관리자 키입니다. 절대 클라이언트/외부/Git에 노출하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=바꾸세요_service_role_키

# 매일 자동 백업(Cron)을 위한 비밀값 - Vercel이 이 값을 Authorization 헤더에 담아 호출합니다.
# 아무 임의의 긴 문자열이면 됩니다. 로컬에서는 실제로 안 쓰이지만 값은 채워두세요.
CRON_SECRET=바꾸세요_임의의_긴_문자열
