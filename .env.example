# 서버 포트 (로컬 전용, Vercel에서는 자동으로 처리됨)
PORT=4000

# 관리자 비밀번호 - 매장 생성/삭제/이름변경 가능
ADMIN_PASSWORD=바꾸세요_관리자비번

# 직원(매장) 비밀번호 - 매장 데이터 조회/수정만 가능 (매장 생성/삭제 불가)
STAFF_PASSWORD=바꾸세요_직원비번

# Supabase 프로젝트 정보 (Supabase 대시보드 > Project Settings > API 에서 확인)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role 키 - 서버 전용 관리자 키입니다. 절대 클라이언트/외부/Git에 노출하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=바꾸세요_service_role_키
